# ==============================================================================
# Dr. Violet's LMS (EdenLMS) — Environment Configuration Template
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env or put secret keys inside VITE_* variables.
# ==============================================================================

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-in-local-dev-use-50-plus-random-chars-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database (PostgreSQL in staging/prod; falls back to SQLite in dev if unset) ---
DATABASE_URL=postgres://edenlms_user:edenlms_password@localhost:5432/edenlms

# --- Same-Origin & CSRF Security ---
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- DPO Pay (Phase 3 - Server-Side Only) ---
DPO_COMPANY_TOKEN=your-dpo-company-token-placeholder
DPO_SERVICE_TYPE=your-dpo-service-type-placeholder
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/

# --- Managed Video Host Signing Key (Phase 4 - Server-Side Only) ---
VIDEO_SIGNING_SECRET=your-video-signing-secret-placeholder
VIDEO_TOKEN_TTL_SECONDS=3600

# --- Cloudflare Turnstile Bot Protection (Phase 2 - Server-Side Verification) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA