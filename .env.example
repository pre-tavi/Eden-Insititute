# ==============================================================================
# Eden Training Institute and Therapy (EdenLMS) — Environment Template
# TVETA License: TVETA/PRIVATE/TVC/0019/2016 | Campus: Buruburu Phase II, Nairobi
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env or .env.local to Git.
# ==============================================================================

# --- Django Core & Hardened Admin Back-Office ---
DJANGO_SECRET_KEY=change-me-in-local-dev-use-64-plus-random-chars-in-prod
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.workers.dev,.pages.dev
DJANGO_ADMIN_URL=eden-instructor-backoffice/
ENFORCE_STAFF_2FA=False

# --- Optional Superuser Bootstrap (Secret Env Vars Only — Never Hardcoded) ---
DJANGO_SUPERUSER_EMAIL=dr.violet@edenlms.org
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_OTP_TOKEN=
DJANGO_SUPERUSER_FORCE_RESET=False

# --- Database (Neon Serverless PostgreSQL in prod; falls back to SQLite locally) ---
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Same-Origin, CORS & CSRF Security ---
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.onrender.com,https://*.workers.dev,https://*.pages.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Transactional Email (SMTP for Password Reset & Notifications) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Eden Training Institute and Therapy <edentherapycentre@gmail.com>

# --- DPO Pay Gateway (Phase 3 - Server-Side Only) ---
DPO_COMPANY_TOKEN=DPO-PILOT-SANDBOX
DPO_SERVICE_TYPE=5525
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/

# --- Managed Video Host Signing Key (Phase 4 - Server-Side HMAC-SHA256) ---
VIDEO_SIGNING_SECRET=change-me-in-local-dev-auto-generated-on-render
VIDEO_TOKEN_TTL_SECONDS=3600

# --- Cloudflare Turnstile Bot Protection (Phase 2) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA